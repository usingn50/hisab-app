{
  "name": "@hisab/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "openapi:generate": "tsx src/openapi/write-document.ts",
    "openapi:validate": "pnpm openapi:generate && pnpm exec redocly lint openapi/hisab-v1.json"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.1.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/swagger-ui": "^5.2.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.4.0",
    "openapi3-ts": "^4.6.1",
    "postgres": "^3.4.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.0",
    "@types/node": "^22.16.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
